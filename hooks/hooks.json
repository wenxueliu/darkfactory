{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\session-start.py\"",
            "statusMessage": "Loading Harness context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|Read|Grep|Glob|Agent|TodoWrite|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/delegation-reminder.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\delegation-reminder.py\"",
            "timeout": 5
          }
        ],
        "description": "Remind orchestrator agents to delegate work to specialized subagents"
      },
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rules-injector.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\rules-injector.py\"",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ],
        "description": "Inject nearby project rules (AGENTS.md/CLAUDE.md) into tool output"
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/write-safety-guard-read.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\write-safety-guard-read.py\"",
            "timeout": 3
          }
        ],
        "description": "Track file reads for write-safety-guard"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/write-safety-guard.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\write-safety-guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Harness write policy"
          }
        ],
        "description": "Block writes to existing files that haven't been read this session"
      },
      {
        "matcher": "Agent|Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ideation-gate.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\ideation-gate.py\"",
            "timeout": 5,
            "statusMessage": "Checking Harness ideation gate"
          }
        ],
        "description": "Block ANY code-writing (Agent delegation or direct Write/Edit) before ideation phase is complete"
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook-cleanup.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\hook-cleanup.py\"",
            "timeout": 3
          }
        ],
        "description": "Clear per-session hook state before context compaction"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-clarifier.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\user-prompt-clarifier.py\"",
            "timeout": 3,
            "additionalContextLimit": 3000
          }
        ],
        "description": "Soft-nudge user toward sw-requirements-clarifier when implementation intent is detected without an in-progress requirement"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end-check.py\"",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%\\hooks\\session-end-check.py\"",
            "timeout": 3
          }
        ],
        "description": "Warn about leftover in-progress tasks and uncommitted worktrees at session end"
      }
    ]
  }
}
